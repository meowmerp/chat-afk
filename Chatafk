--========================================================--
-- ChatClicker (Original Boxy GUI - Stable Version)
--========================================================--

local UIS = game:GetService("UserInputService")
local VIM = game:GetService("VirtualInputManager")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

--================ CONFIG =================--
local CLICK_POS = Vector2.new(139, 32)
local CLICK_DELAY = 0.6
local running = false
local destroyed = false
local loopThread = nil
--==========================================--

--================ CLICK LOGIC =================--
local function clickOnce()
    VIM:SendMouseButtonEvent(CLICK_POS.X, CLICK_POS.Y, 0, true, game, 1)
    task.wait(0.05)
    VIM:SendMouseButtonEvent(CLICK_POS.X, CLICK_POS.Y, 0, false, game, 1)
end

local function doCycle()
    clickOnce()
    task.wait(CLICK_DELAY)
    clickOnce()
end

--================ GUI CLEANUP =================--
local oldGui = player:WaitForChild("PlayerGui"):FindFirstChild("ChatClickerGui")
if oldGui then oldGui:Destroy() end

--================ ORIGINAL BOXY GUI =================--

local gui = Instance.new("ScreenGui")
gui.Name = "ChatClickerGui"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 200, 0, 120)
frame.Position = UDim2.new(0, 20, 0, 100)
frame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
frame.BorderSizePixel = 2
frame.BorderColor3 = Color3.fromRGB(20, 20, 20)
frame.Active = true
frame.Parent = gui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 30)
title.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
title.BorderSizePixel = 2
title.BorderColor3 = Color3.fromRGB(20, 20, 20)
title.Text = "ChatClicker"
title.TextColor3 = Color3.fromRGB(255, 255, 255)
title.Font = Enum.Font.SourceSansBold
title.TextSize = 20
title.Parent = frame

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, 0, 0, 25)
status.Position = UDim2.new(0, 0, 0, 35)
status.BackgroundTransparency = 1
status.Text = "Status: OFF"
status.TextColor3 = Color3.fromRGB(255, 60, 60)
status.Font = Enum.Font.SourceSansBold
status.TextSize = 18
status.Parent = frame

local toggleBtn = Instance.new("TextButton")
toggleBtn.Size = UDim2.new(1, -20, 0, 30)
toggleBtn.Position = UDim2.new(0, 10, 0, 65)
toggleBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
toggleBtn.BorderSizePixel = 2
toggleBtn.BorderColor3 = Color3.fromRGB(20, 20, 20)
toggleBtn.Text = "Toggle (F8)"
toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleBtn.Font = Enum.Font.SourceSansBold
toggleBtn.TextSize = 18
toggleBtn.Parent = frame

local destroyBtn = Instance.new("TextButton")
destroyBtn.Size = UDim2.new(1, -20, 0, 30)
destroyBtn.Position = UDim2.new(0, 10, 0, 100)
destroyBtn.BackgroundColor3 = Color3.fromRGB(80, 30, 30)
destroyBtn.BorderSizePixel = 2
destroyBtn.BorderColor3 = Color3.fromRGB(20, 20, 20)
destroyBtn.Text = "Destroy (])"
destroyBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
destroyBtn.Font = Enum.Font.SourceSansBold
destroyBtn.TextSize = 18
destroyBtn.Parent = frame

--================ LOOP =================--
local function updateGui()
    if running then
        status.Text = "Status: ON"
        status.TextColor3 = Color3.fromRGB(0, 255, 120)
    else
        status.Text = "Status: OFF"
        status.TextColor3 = Color3.fromRGB(255, 60, 60)
    end
end

local function startLoop()
    if loopThread then return end
    loopThread = task.spawn(function()
        while running and not destroyed do
            doCycle()
            task.wait(3)
        end
        loopThread = nil
    end)
end

local function stopLoop()
    running = false
    loopThread = nil
end

--================ BUTTONS =================--
toggleBtn.MouseButton1Click:Connect(function()
    running = not running
    if running then startLoop() else stopLoop() end
    updateGui()
end)

destroyBtn.MouseButton1Click:Connect(function()
    destroyed = true
    running = false
    loopThread = nil
    gui:Destroy()
end)

--================ KEYBINDS =================--
UIS.InputBegan:Connect(function(input, gp)
    if gp or destroyed then return end
    if input.KeyCode == Enum.KeyCode.F8 then
        running = not running
        if running then startLoop() else stopLoop() end
        updateGui()
    elseif input.KeyCode == Enum.KeyCode.RightBracket then
        destroyed = true
        running = false
        loopThread = nil
        gui:Destroy()
    end
end)

updateGui()
