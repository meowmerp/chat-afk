--========================================================--
-- ChatClicker (Optimized Rewrite)
-- Two clicks per cycle (open → close)
-- F8 = toggle on/off
-- ]  = destroy GUI + stop loop
-- Slider = delay between cycles (1–20s)
--========================================================--

local UIS  = game:GetService("UserInputService")
local VIM  = game:GetService("VirtualInputManager")
local Plrs = game:GetService("Players")
local player = Plrs.LocalPlayer

--================ CONFIG ==================--
local CLICK_POS = Vector2.new(139, 32)   -- chat bubble coords
local CLICK_DELAY = 0.6                  -- delay between open/close
--===========================================--

-- Persistent state
getgenv().ChatClicker = getgenv().ChatClicker or {}
local state = getgenv().ChatClicker
state.running   = false
state.loopDelay = state.loopDelay or 3
state.gui       = nil

local destroyed = false
local loopThread = nil

--================ CLICK FUNCTION ==================--
local function clickOnce()
    VIM:SendMouseButtonEvent(CLICK_POS.X, CLICK_POS.Y, 0, true,  game, 1)
    task.wait(0.05)
    VIM:SendMouseButtonEvent(CLICK_POS.X, CLICK_POS.Y, 0, false, game, 1)
end

local function doCycle()
    clickOnce()                -- open
    task.wait(CLICK_DELAY)
    clickOnce()                -- close
end

--================ GUI CLEANUP ==================--
if state.gui then
    pcall(function() state.gui:Destroy() end)
    state.gui = nil
end

--================ GUI CREATION ==================--
local gui = Instance.new("ScreenGui")
gui.Name = "ChatClickerGui"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true

-- Parent to exploit UI if available
local ok, hui = pcall(function() return gethui and gethui() end)
gui.Parent = ok and hui or player:WaitForChild("PlayerGui")
state.gui = gui

-- Main frame
local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 240, 0, 160)
frame.Position = UDim2.new(0, 20, 0, 100)
frame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
frame.BorderSizePixel = 0
frame.Active = true
frame.Parent = gui

Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 8)

--================ DRAG BAR ==================--
local dragBar = Instance.new("TextLabel")
dragBar.Size = UDim2.new(1, 0, 0, 28)
dragBar.BackgroundTransparency = 1
dragBar.Text = "Chat Clicker"
dragBar.TextColor3 = Color3.fromRGB(220, 220, 220)
dragBar.Font = Enum.Font.GothamBold
dragBar.TextSize = 14
dragBar.Active = true
dragBar.Parent = frame

local dragStart, startPos

dragBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragStart = input.Position
        startPos  = frame.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragStart and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragStart = nil
    end
end)

--================ LABELS ==================--
local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, 0, 0, 22)
status.Position = UDim2.new(0, 0, 0, 28)
status.BackgroundTransparency = 1
status.TextColor3 = Color3.fromRGB(255, 90, 90)
status.Text = "OFF"
status.Font = Enum.Font.Gotham
status.TextSize = 14
status.Parent = frame

local coordLabel = Instance.new("TextLabel")
coordLabel.Size = UDim2.new(1, 0, 0, 20)
coordLabel.Position = UDim2.new(0, 0, 0, 52)
coordLabel.BackgroundTransparency = 1
coordLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
coordLabel.Text = "click @ (" .. CLICK_POS.X .. ", " .. CLICK_POS.Y .. ")"
coordLabel.Font = Enum.Font.Gotham
coordLabel.TextSize = 12
coordLabel.Parent = frame

local delayLabel = Instance.new("TextLabel")
delayLabel.Size = UDim2.new(1, 0, 0, 20)
delayLabel.Position = UDim2.new(0, 0, 0, 72)
delayLabel.BackgroundTransparency = 1
delayLabel.TextColor3 = Color3.fromRGB(120, 190, 255)
delayLabel.Text = "Loop delay: " .. state.loopDelay .. "s"
delayLabel.Font = Enum.Font.Gotham
delayLabel.TextSize = 12
delayLabel.Parent = frame

--================ SLIDER ==================--
local sliderBg = Instance.new("Frame")
sliderBg.Size = UDim2.new(1, -24, 0, 12)
sliderBg.Position = UDim2.new(0, 12, 0, 100)
sliderBg.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
sliderBg.BorderSizePixel = 0
sliderBg.Active = true
sliderBg.Parent = frame
Instance.new("UICorner", sliderBg).CornerRadius = UDim.new(1, 0)

local sliderFill = Instance.new("Frame")
sliderFill.BackgroundColor3 = Color3.fromRGB(120, 190, 255)
sliderFill.BorderSizePixel = 0
sliderFill.ZIndex = 3
sliderFill.Parent = sliderBg
Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(1, 0)

local knob = Instance.new("Frame")
knob.Size = UDim2.new(0, 18, 0, 18)
knob.AnchorPoint = Vector2.new(0.5, 0.5)
knob.BackgroundColor3 = Color3.fromRGB(220, 220, 220)
knob.BorderSizePixel = 0
knob.ZIndex = 4
knob.Active = true
knob.Parent = sliderBg
Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

local function applySlider(pct)
    sliderFill.Size = UDim2.new(pct, 0, 1, 0)
    knob.Position   = UDim2.new(pct, 0, 0.5, 0)
    local val = math.floor(1 + pct * 19 + 0.5)
    state.loopDelay = math.clamp(val, 1, 20)
    delayLabel.Text = "Loop delay: " .. state.loopDelay .. "s"
end

applySlider((state.loopDelay - 1) / 19)

local draggingSlider = false

local function updateSlider(input)
    local barPos = sliderBg.AbsolutePosition.X
    local barSize = sliderBg.AbsoluteSize.X
    local rel = math.clamp(input.Position.X - barPos, 0, barSize)
    applySlider(rel / barSize)
end

sliderBg.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingSlider = true
        updateSlider(input)
    end
end)

knob.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingSlider = true
    end
end)

UIS.InputChanged:Connect(function(input)
    if draggingSlider and input.UserInputType == Enum.UserInputType.MouseMovement then
        updateSlider(input)
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        draggingSlider = false
    end
end)

--================ LOOP ==================--
local function updateGui()
    if state.running then
        status.Text = "ON"
        status.TextColor3 = Color3.fromRGB(120, 230, 120)
    else
        status.Text = "OFF"
        status.TextColor3 = Color3.fromRGB(255, 90, 90)
    end
end

local function startLoop()
    if loopThread then return end
    loopThread = task.spawn(function()
        while state.running and not destroyed do
            local ok, err = pcall(function()
                doCycle()
                task.wait(state.loopDelay)
            end)
            if not ok then
                warn("[ChatClicker] error: " .. tostring(err))
                state.running = false
                updateGui()
                break
            end
        end
        loopThread = nil
    end)
end

local function stopLoop()
    state.running = false
    loopThread = nil
end

--================ KEYBINDS ==================--
local function toggle()
    if destroyed then return end
    state.running = not state.running
    if state.running then startLoop() else stopLoop() end
    updateGui()
end

local function destroy()
    if destroyed then return end
    destroyed = true
    state.running = false
    loopThread = nil
    if state.gui then
        pcall(function() state.gui:Destroy() end)
        state.gui = nil
    end
    print("[ChatClicker] destroyed")
end

UIS.InputBegan:Connect(function(input, gp)
    if gp or destroyed then return end
    if input.KeyCode == Enum.KeyCode.F8 then
        toggle()
    elseif input.KeyCode == Enum.KeyCode.RightBracket then
        destroy()
    end
end)

updateGui()
print("[ChatClicker] loaded — F8 toggle · ] destroy")
