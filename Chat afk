--========================================================--
-- ChatClicker (Final Premium Version)
--========================================================--

local UIS          = game:GetService("UserInputService")
local VIM          = game:GetService("VirtualInputManager")
local TweenService = game:GetService("TweenService")
local Players      = game:GetService("Players")
local player       = Players.LocalPlayer

--================ CONFIG =================--
local CLICK_POS   = Vector2.new(139, 32)
local CLICK_DELAY = 0.6
--==========================================--

getgenv().ChatClicker = getgenv().ChatClicker or {}
local state = getgenv().ChatClicker
state.running   = state.running   or false
state.loopDelay = state.loopDelay or 3
state.gui       = state.gui       or nil

local destroyed  = false
local loopThread = nil

--================ CLICK LOGIC =================--
local function clickOnce()
    VIM:SendMouseButtonEvent(CLICK_POS.X, CLICK_POS.Y, 0, true,  game, 1)
    task.wait(0.05)
    VIM:SendMouseButtonEvent(CLICK_POS.X, CLICK_POS.Y, 0, false, game, 1)
end

local function doCycle()
    clickOnce()
    task.wait(CLICK_DELAY)
    clickOnce()
end

--================ GUI CLEANUP =================--
if state.gui then
    pcall(function() state.gui:Destroy() end)
    state.gui = nil
end

--================ PREMIUM GUI =================--
local gui = Instance.new("ScreenGui")
gui.Name = "ChatClickerGui"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true

do
    local ok, hui = pcall(function() return gethui and gethui() end)
    gui.Parent = ok and hui or player:WaitForChild("PlayerGui")
end

state.gui = gui

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 260, 0, 170)
frame.Position = UDim2.new(0, 20, 0, 100)
frame.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
frame.BorderSizePixel = 0
frame.Active = true
frame.ZIndex = 5
frame.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 10)
corner.Parent = frame

local glow = Instance.new("ImageLabel")
glow.Name = "Glow"
glow.Parent = frame
glow.AnchorPoint = Vector2.new(0.5, 0.5)
glow.Position = UDim2.new(0.5, 0, 0.5, 0)
glow.Size = UDim2.new(1, 40, 1, 40)
glow.BackgroundTransparency = 1
glow.Image = "rbxassetid://5028857084"
glow.ImageColor3 = Color3.fromRGB(0, 170, 255)
glow.ImageTransparency = 0.55
glow.ZIndex = 0

local dragBar = Instance.new("TextLabel")
dragBar.Size = UDim2.new(1, 0, 0, 32)
dragBar.BackgroundTransparency = 1
dragBar.Text = "ChatClicker"
dragBar.TextColor3 = Color3.fromRGB(230, 230, 230)
dragBar.Font = Enum.Font.GothamBold
dragBar.TextSize = 16
dragBar.Active = true
dragBar.ZIndex = 6
dragBar.Parent = frame

local minimize = Instance.new("TextButton")
minimize.Size = UDim2.new(0, 26, 0, 26)
minimize.Position = UDim2.new(1, -32, 0, 3)
minimize.BackgroundTransparency = 1
minimize.Text = "-"
minimize.TextColor3 = Color3.fromRGB(230, 230, 230)
minimize.Font = Enum.Font.GothamBold
minimize.TextSize = 20
minimize.ZIndex = 6
minimize.Parent = frame

local minimized = false

minimize.MouseButton1Click:Connect(function()
    minimized = not minimized
    for _, child in ipairs(frame:GetChildren()) do
        if child ~= dragBar and child ~= minimize and child ~= glow then
            child.Visible = not minimized
        end
    end
    frame.Size = minimized and UDim2.new(0, 260, 0, 32) or UDim2.new(0, 260, 0, 170)
end)

local dragStart, startPos

dragBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragStart = input.Position
        startPos  = frame.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragStart and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragStart = nil
    end
end)

local led = Instance.new("Frame")
led.Size = UDim2.new(0, 12, 0, 12)
led.Position = UDim2.new(0, 12, 0, 40)
led.BackgroundColor3 = Color3.fromRGB(255, 70, 70)
led.BorderSizePixel = 0
led.ZIndex = 6
led.Parent = frame

local ledCorner = Instance.new("UICorner")
ledCorner.CornerRadius = UDim.new(1, 0)
ledCorner.Parent = led

local coordLabel = Instance.new("TextLabel")
coordLabel.Size = UDim2.new(1, -20, 0, 20)
coordLabel.Position = UDim2.new(0, 10, 0, 60)
coordLabel.BackgroundTransparency = 1
coordLabel.TextColor3 = Color3.fromRGB(140, 140, 140)
coordLabel.Text = "Click @ (" .. CLICK_POS.X .. ", " .. CLICK_POS.Y .. ")"
coordLabel.Font = Enum.Font.Gotham
